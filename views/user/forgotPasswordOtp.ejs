<%- include("../partials/header") %>

<main class="forgot-otp-page">

    <section class="forgot-otp-card">

        <h1 class="forgot-otp-title">
            Verify OTP
        </h1>


        <p class="forgot-otp-description">

            We've sent a 6-digit code to
            <strong><%= email %></strong>

        </p>


        <form
            id="forgotOtpForm"
            class="forgot-otp-form"
        >

            <div class="otp-inputs">

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

                <input
                    type="text"
                    maxlength="1"
                    class="otp-input"
                    inputmode="numeric"
                >

            </div>


            <div class="forgot-otp-resend">

                Didn't receive code?

                <button
                    type="button"
                    id="resendOtpBtn"
                    disabled
                >
                    Resend OTP (<span id="timer">30</span>s)
                </button>

            </div>


            <button
                type="submit"
                class="forgot-otp-submit"
            >
                VERIFY OTP
            </button>


            <a
                href="/auth/forgot-password"
                class="forgot-otp-back"
            >
                ← &nbsp; Back
            </a>

        </form>

    </section>

</main>
<footer class="border-t border-gray-200 bg-[#F8F5EF]">

    <div class="h-[80px] flex items-center justify-center">

        <p class="uppercase tracking-[4px] text-[12px] text-gray-700">

            © 2024 Wristora Maison De Haute Horlogerie

        </p>

    </div>

</footer>

</body>
</html>


<script>

const otpInputs =
    document.querySelectorAll(".otp-input");

const form =
    document.getElementById("forgotOtpForm");

const resendBtn =
    document.getElementById("resendOtpBtn");

const timerElement =
    document.getElementById("timer");


// =====================================================
// RESEND TIMER
// =====================================================

let seconds = 30;
let countdown = null;


// =====================================================
// START TIMER
// =====================================================

const startTimer = () => {

    // Clear previous timer if one exists
    if (countdown) {
        clearInterval(countdown);
    }

    seconds = 30;

    resendBtn.disabled = true;

    resendBtn.innerHTML =
        `Resend OTP (<span id="timer">${seconds}</span>s)`;

    // Get the newly created timer element
    const timer =
        document.getElementById("timer");


    countdown = setInterval(() => {

        seconds--;

        timer.textContent = seconds;


        if (seconds <= 0) {

            clearInterval(countdown);

            countdown = null;

            resendBtn.disabled = false;

            resendBtn.textContent =
                "Resend OTP";

        }

    }, 1000);

};


// =====================================================
// CLEAR OTP INPUTS
// =====================================================

const clearOtpInputs = () => {

    otpInputs.forEach(input => {

        input.value = "";

    });

    // Focus first box
    otpInputs[0].focus();

};


// =====================================================
// OTP INPUT
// =====================================================

otpInputs.forEach((input, index) => {


    input.addEventListener("input", () => {

        // Allow only numbers
        input.value =
            input.value.replace(/\D/g, "");


        // Move to next box
        if (
            input.value &&
            index < otpInputs.length - 1
        ) {

            otpInputs[index + 1].focus();

        }

    });


    // Backspace
    input.addEventListener("keydown", (event) => {

        if (
            event.key === "Backspace" &&
            !input.value &&
            index > 0
        ) {

            otpInputs[index - 1].focus();

        }

    });


    // Paste complete OTP
    input.addEventListener("paste", (event) => {

        event.preventDefault();


        const pastedData =
            event.clipboardData
                .getData("text")
                .replace(/\D/g, "")
                .slice(0, 6);


        pastedData.split("").forEach((digit, i) => {

            if (otpInputs[i]) {

                otpInputs[i].value = digit;

            }

        });


        // Focus last filled box
        if (pastedData.length > 0) {

            const nextIndex =
                Math.min(
                    pastedData.length,
                    otpInputs.length - 1
                );

            otpInputs[nextIndex].focus();

        }

    });

});


// =====================================================
// VERIFY OTP
// =====================================================

form.addEventListener("submit", async (event) => {

    event.preventDefault();


    let otp = "";


    otpInputs.forEach(input => {

        otp += input.value;

    });


    if (!/^\d{6}$/.test(otp)) {

        Swal.fire({

            icon: "warning",

            title: "Invalid OTP",

            text:
                "Please enter the complete 6-digit OTP.",

            confirmButtonColor: "#292929"

        });

        return;

    }


    try {

        const response =
            await fetch(
                "/auth/forgot-password/verify-otp",
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        otp
                    })

                }
            );


        const result =
            await response.json();


        if (result.success) {

            Swal.fire({

                icon: "success",

                title: "OTP Verified",

                text:
                    result.message,

                confirmButtonColor: "#292929"

            }).then(() => {

                window.location.href =
                    "/auth/reset-password";

            });

            return;

        }


        Swal.fire({

            icon: "error",

            title: "Verification Failed",

            text:
                result.message,

            confirmButtonColor: "#292929"

        });


    } catch (error) {

        console.error(error);

        Swal.fire({

            icon: "error",

            title: "Something went wrong",

            text:
                "Please try again.",

            confirmButtonColor: "#292929"

        });

    }

});


// =====================================================
// RESEND OTP
// =====================================================

resendBtn.addEventListener(
    "click",
    async () => {

        // Prevent multiple clicks
        resendBtn.disabled = true;


        try {

            const response =
                await fetch(
                    "/auth/forgot-password/resend-otp",
                    {
                        method: "POST"
                    }
                );


            const result =
                await response.json();


            // =================================================
            // SUCCESS
            // =================================================

            if (result.success) {

                // Clear previous OTP
                clearOtpInputs();


                Swal.fire({

                    icon: "success",

                    title: "OTP Sent",

                    text:
                        result.message,

                    confirmButtonColor:
                        "#292929"

                });


                // Restart timer
                startTimer();


                return;

            }


            // =================================================
            // RESEND FAILED
            // =================================================

            Swal.fire({

                icon: "error",

                title: "Unable to Resend",

                text:
                    result.message,

                confirmButtonColor:
                    "#292929"

            });


            // If backend gives remaining time
            if (result.remainingSeconds) {

                seconds =
                    result.remainingSeconds;

            }


            resendBtn.disabled = false;


        } catch (error) {

            console.error(error);


            resendBtn.disabled = false;


            Swal.fire({

                icon: "error",

                title: "Something went wrong",

                text:
                    "Please try again.",

                confirmButtonColor:
                    "#292929"

            });

        }

    }
);


// =====================================================
// START INITIAL TIMER
// =====================================================

startTimer();

</script>