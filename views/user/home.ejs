<%- include("../partials/header") %>

<link rel="stylesheet" href="/css/home.css">

<main class="home-page">

    <!-- ================= HERO SECTION ================= -->
    <section class="hero-section">

        <div class="hero-content">

            <h1>
                Timeless<br>
                <span>Masterpieces</span> for<br>
                the Elite.
            </h1>

            <p class="hero-description">
                Experience the zenith of horology. Explore our
                curated selection of pre-owned and vintage icons
                from the world's most prestigious maisons.
            </p>

            <a href="/products" class="primary-btn">
                SHOP NOW
            </a>

            <div class="hero-stats">

                <div class="stat-item">
                    <strong>450+</strong>
                    <span>PIECES SOLD</span>
                </div>

                <div class="stat-item">
                    <strong>120+</strong>
                    <span>WATCHMAKERS</span>
                </div>

                <div class="stat-item">
                    <strong>98%</strong>
                    <span>CLIENT TRUST</span>
                </div>

            </div>

        </div>

        <div class="hero-image-wrapper">
            <img
                src="/images/hero-watch.png"
                alt="Luxury Wristora Watch"
                class="hero-image"
            >
        </div>

    </section>


    <!-- ================= NEW ACQUISITIONS ================= -->
    <section class="products-section">

        <h2 class="section-title">
            NEW ACQUISITIONS
        </h2>

        <% if (acquisitions.length === 0) { %>
            <p class="home-empty-text">New pieces are arriving soon.</p>
        <% } %>

        <div class="product-grid">

            <% acquisitions.forEach((product) => { %>

                <a href="/products/<%= product._id %>" class="product-card">

                    <div class="product-image-box">

                        <% if (product.discount && product.discount > 0) { %>
                            <span class="product-badge rare">-<%= product.discount %>%</span>
                        <% } else if (product.stock <= 0) { %>
                            <span class="product-badge">SOLD OUT</span>
                        <% } %>

                        <% if (product.images && product.images.length > 0) { %>
                            <img src="<%= product.images[0].url %>" alt="<%= product.productName %>">
                        <% } %>

                    </div>

                    <h3><%= product.productName %></h3>

                    <% if (product.category && product.category.name) { %>
                        <p class="product-category"><%= product.category.name %></p>
                    <% } else if (product.brand) { %>
                        <p class="product-category"><%= product.brand %></p>
                    <% } %>

                    <p class="product-price">
                        &#8377;<%= product.sellingPrice.toLocaleString("en-IN") %>
                        <% if (product.discount && product.discount > 0) { %>
                            <del>&#8377;<%= product.price.toLocaleString("en-IN") %></del>
                        <% } %>
                    </p>

                </a>

            <% }) %>

        </div>

        <div class="section-button-wrapper">

            <a href="/products" class="outline-btn">
                VIEW ENTIRE ARCHIVE
            </a>

        </div>

    </section>


    <!-- ================= NEW ARRIVALS ================= -->
    <section class="products-section arrivals-section">

        <h2 class="section-title">
            NEW ARRIVALS
        </h2>

        <% if (arrivals.length === 0) { %>
            <p class="home-empty-text">New pieces are arriving soon.</p>
        <% } %>

        <div class="product-grid">

            <% arrivals.forEach((product) => { %>

                <a href="/products/<%= product._id %>" class="product-card">

                    <div class="product-image-box white-bg">

                        <% if (product.discount && product.discount > 0) { %>
                            <span class="product-badge rare">-<%= product.discount %>%</span>
                        <% } else if (product.stock <= 0) { %>
                            <span class="product-badge">SOLD OUT</span>
                        <% } %>

                        <% if (product.images && product.images.length > 0) { %>
                            <img src="<%= product.images[0].url %>" alt="<%= product.productName %>">
                        <% } %>

                    </div>

                    <h3><%= product.productName %></h3>

                    <% if (product.category && product.category.name) { %>
                        <p class="product-category"><%= product.category.name %></p>
                    <% } else if (product.brand) { %>
                        <p class="product-category"><%= product.brand %></p>
                    <% } %>

                    <p class="product-price">
                        &#8377;<%= product.sellingPrice.toLocaleString("en-IN") %>
                        <% if (product.discount && product.discount > 0) { %>
                            <del>&#8377;<%= product.price.toLocaleString("en-IN") %></del>
                        <% } %>
                    </p>

                </a>

            <% }) %>

        </div>

        <div class="section-button-wrapper">

            <a href="/products" class="outline-btn">
                BROWSE FULL COLLECTION
            </a>

        </div>

    </section>


    <!-- ================= SHOP BY BRAND ================= -->
    <section class="brand-section">

        <h2 class="section-title">
            SHOP BY BRAND
        </h2>

        <div class="brand-grid">

            <a href="/products?brand=Rolex" class="brand-card">
                <img
                    src="/images/rolex-logo.jpg"
                    alt="Rolex"
                >
            </a>

            <a href="/products?brand=Omega" class="brand-card">
                <img
                    src="/images/omega-logo.jpg"
                    alt="Omega"
                >
            </a>

            <a href="/products?brand=Cartier" class="brand-card">
                <img
                    src="/images/cartier-logo.jpg"
                    alt="Cartier"
                >
            </a>

            <a href="/products?brand=Patek%20Philippe" class="brand-card">
                <img
                    src="/images/patek-logo.jpg"
                    alt="Patek Philippe"
                >
            </a>

            <a href="/products?brand=Audemars%20Piguet" class="brand-card">
                <img
                    src="/images/ap-logo.jpg"
                    alt="Audemars Piguet"
                >
            </a>

        </div>

    </section>


    <!-- ================= COLLECTOR VOICES ================= -->
    <section class="testimonials-section">

        <h2 class="testimonial-title">
            COLLECTOR VOICES
        </h2>

        <div class="testimonial-grid">

            <!-- Testimonial 1 -->
            <div class="testimonial-card">

                <div class="testimonial-rating">
                    ★★★★★
                </div>

                <div class="collector-name">
                    Julian V.
                    <span>●</span>
                </div>

                <p>
                    "The provenance provided with my 1968
                    GMT-Master was impeccable. Wristora
                    understands that we aren't just buying
                    watches, we're acquiring history."
                </p>

            </div>


            <!-- Testimonial 2 -->
            <div class="testimonial-card">

                <div class="testimonial-rating">
                    ★★★★★
                </div>

                <div class="collector-name">
                    Henry R.
                    <span>●</span>
                </div>

                <p>
                    "Finding a Patek with original papers in
                    this condition is rarity. The concierge
                    service made the transition of ownership
                    seamless and secure."
                </p>

            </div>


            <!-- Testimonial 3 -->
            <div class="testimonial-card">

                <div class="testimonial-rating">
                    ★★★★★
                </div>

                <div class="collector-name">
                    Marcus T.
                    <span>●</span>
                </div>

                <p>
                    "Wristora's attention to detail during the
                    inspection process gave me the confidence
                    to buy remotely. A truly first-class
                    horological experience."
                </p>

            </div>

        </div>

    </section>

</main>


<%- include("../partials/footer1") %>