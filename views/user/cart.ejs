<%- include("../partials/header", { title: title, user: user }) %>

<link rel="stylesheet" href="/css/products.css">
<link rel="stylesheet" href="/css/cart.css">

<main class="cart-page">

    <div class="cart-container">

        <!-- =====================================================
             BREADCRUMB
        ====================================================== -->

        <p class="products-breadcrumb">
            <a href="/">HOME</a> &gt;
            <a href="/products">PRODUCTS</a> &gt; CART
        </p>


        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="cart-page-header">

            <h1 class="products-title">
                Your Cart
            </h1>

        </div>


        <!-- =====================================================
             ERROR (backend/database failure)
        ====================================================== -->

        <% if (typeof error !== "undefined" && error) { %>

            <div class="products-error">
                <%= error %>
            </div>

        <% } %>


        <% if (typeof checkoutMessage !== "undefined" && checkoutMessage) { %>

            <div class="products-error">
                <%= checkoutMessage %>
            </div>

        <% } %>


        <% if (cartItems && cartItems.length > 0) { %>

            <div class="cart-layout">

                <!-- =============================================
                     CART ITEMS
                ============================================== -->

                <div class="cart-items">

                    <% cartItems.forEach((item) => { %>

                        <div class="cart-item <%= (item.isMissing || !item.isAvailable) ? 'cart-item-disabled' : '' %>"
                             data-product-id="<%= item.productId %>">

                            <div class="cart-item-image">

                                <% if (!item.isMissing && item.image) { %>

                                    <img
                                        src="<%= item.image %>"
                                        alt="<%= item.productName %>"
                                        onerror="this.style.display='none'; this.parentElement.classList.add('image-missing');"
                                    >

                                <% } else { %>

                                    <div class="image-missing"></div>

                                <% } %>

                            </div>


                            <div class="cart-item-info">

                                <% if (item.isMissing) { %>

                                    <h3 class="cart-item-name">Product unavailable</h3>

                                <% } else { %>

                                    <h3 class="cart-item-name">
                                        <%= item.productName %>
                                    </h3>

                                    <% if (item.brand) { %>

                                        <p class="cart-item-brand">
                                            <%= item.brand %>
                                        </p>

                                    <% } %>

                                    <p class="cart-item-price">
                                        &#8377;<%= item.sellingPrice.toLocaleString("en-IN") %>
                                    </p>

                                <% } %>


                                <!-- =====================================
                                     STATE MESSAGES
                                ====================================== -->

                                <% if (item.isMissing || !item.isAvailable) { %>

                                    <p class="cart-item-message cart-item-message-error">
                                        This product is no longer available.
                                    </p>

                                <% } else if (item.isOutOfStock) { %>

                                    <p class="cart-item-message cart-item-message-error">
                                        Out of Stock
                                    </p>

                                <% } else if (item.exceedsStock) { %>

                                    <p class="cart-item-message cart-item-message-warning">
                                        Only <%= item.stock %> available.
                                    </p>

                                <% } else if (item.stock <= 2) { %>

                                    <p class="cart-item-message cart-item-message-warning">
                                        Only <%= item.stock %> left.
                                    </p>

                                <% } %>

                                <p class="cart-item-inline-message" data-role="inline-message"></p>

                            </div>


                            <div class="cart-item-qty">

                                <% if (item.isMissing || !item.isAvailable || item.isOutOfStock) { %>

                                    <span class="cart-qty-static">Qty: <%= item.quantity %></span>

                                <% } else { %>

                                    <div class="cart-qty-controls">

                                        <button
                                            type="button"
                                            class="cart-qty-btn cart-qty-decrease"
                                            aria-label="Decrease quantity"
                                            <%= item.quantity <= 1 ? "disabled" : "" %>
                                        >&minus;</button>

                                        <span class="cart-qty-value" data-role="quantity"><%= item.quantity %></span>

                                        <button
                                            type="button"
                                            class="cart-qty-btn cart-qty-increase"
                                            aria-label="Increase quantity"
                                            <%= item.atMax ? "disabled" : "" %>
                                        >+</button>

                                    </div>

                                <% } %>

                            </div>


                            <div class="cart-item-subtotal" data-role="subtotal">

                                <% if (!item.isMissing && item.isAvailable) { %>

                                    &#8377;<%= item.subtotal.toLocaleString("en-IN") %>

                                <% } else { %>

                                    &mdash;

                                <% } %>

                            </div>


                            <form
                                action="/cart/remove/<%= item.productId %>"
                                method="POST"
                                class="cart-item-remove-form"
                               
                            >

                                <button
                                    type="submit"
                                    class="cart-item-remove-btn"
                                    aria-label="Remove item"
                                >
                                    <i class="bi bi-trash"></i>
                                </button>

                            </form>

                        </div>

                    <% }) %>

                </div>


                <!-- =============================================
                     SUMMARY
                ============================================== -->

                <div class="cart-summary">

                    <h2>Summary</h2>

                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <span data-role="cart-subtotal">&#8377;<%= cartTotal.toLocaleString("en-IN") %></span>
                    </div>

                    <div class="cart-summary-divider"></div>

                    <div class="cart-summary-row cart-summary-total">
                        <span>Total</span>
                        <span data-role="cart-total">&#8377;<%= cartTotal.toLocaleString("en-IN") %></span>
                    </div>

                    <a href="/checkout" class="cart-continue-btn">
                        Proceed to Checkout
                    </a>

                    <a href="/products" class="cart-continue-btn">
                        Continue Shopping
                    </a>

                </div>

            </div>

        <% } else { %>

            <!-- =================================================
                 EMPTY CART STATE
            ================================================== -->

            <div class="products-empty-state">

                <div class="products-empty-icon">
                    <i class="bi bi-cart3"></i>
                </div>

                <h2>Your cart is empty</h2>

                <p>
                    Looks like you haven't added any timepieces yet.
                </p>

                <a href="/products" class="products-empty-btn">
                    Continue Shopping
                </a>

            </div>

        <% } %>

    </div>

</main>

<script src="/js/cart.js"></script>

<script>

document
    .querySelectorAll(".cart-item-remove-form")
    .forEach((form) => {

        form.addEventListener("submit", function (event) {

            event.preventDefault();

            Swal.fire({

                title: "Remove this item from your cart?",

                icon: "warning",

                showCancelButton: true,

                confirmButtonText: "Yes, remove it",

                cancelButtonText: "Cancel",

                reverseButtons: true

            }).then((result) => {

                if (result.isConfirmed) {

                    form.submit();

                }

            });

        });

    });

</script>

<%- include("../partials/footer2") %>