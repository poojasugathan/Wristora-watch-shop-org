<%- include("../partials/header", { title: "Change Password", user: user }) %>

<link rel="stylesheet" href="/css/profile.css">


<main class="account-settings-page">

    <div class="account-settings-container">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="account-settings-sidebar">

            <nav class="account-settings-menu">

                <a
                    href="/profile"
                    class="account-settings-link active"
                >
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>


                <a
                    href="/orders"
                    class="account-settings-link"
                >
                    <i class="bi bi-box-seam"></i>
                    <span>My Orders</span>
                </a>


                <a
                    href="/wishlist"
                    class="account-settings-link"
                >
                    <i class="bi bi-heart"></i>
                    <span>Wishlist</span>
                </a>


                <a
                    href="/addresses"
                    class="account-settings-link"
                >
                    <i class="bi bi-geo-alt"></i>
                    <span>Addresses</span>
                </a>


                <a
                    href="/wallet"
                    class="account-settings-link"
                >
                    <i class="bi bi-wallet2"></i>
                    <span>Wallet</span>
                </a>


                <a
                    href="/coupons"
                    class="account-settings-link"
                >
                    <i class="bi bi-tag"></i>
                    <span>My Coupons</span>
                </a>

            </nav>


            <!-- LOGOUT -->

            <form
                action="/auth/logout"
                method="POST"
                class="account-settings-logout-form"
            >

                <button
                    type="submit"
                    class="account-settings-logout"
                >
                    LOGOUT
                </button>

            </form>

        </aside>



        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <section class="account-settings-content">


            <!-- PAGE HEADING -->

            <div class="account-settings-heading">

                <h1>
                    Change Password
                </h1>

                <p>
                    Update your password to keep your account secure.
                </p>

            </div>



            <!-- =================================================
                 SUCCESS MESSAGE
            ================================================== -->

            <% if (successMessage) { %>

                <div class="account-settings-success">

                    <i class="bi bi-check-circle"></i>

                    <span>
                        <%= successMessage %>
                    </span>

                </div>

            <% } %>



            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (errorMessage) { %>

                <div class="account-settings-error">

                    <i class="bi bi-exclamation-circle"></i>

                    <span>
                        <%= errorMessage %>
                    </span>

                </div>

            <% } %>



            <!-- =================================================
                 CHANGE PASSWORD CARD
            ================================================== -->

            <div class="account-settings-card">


                <div class="account-settings-card-header">

                    <h2>
                        Change Password
                    </h2>

                </div>



                <!-- =================================================
                     PASSWORD FORM
                ================================================== -->

                <form
                    action="/profile/change-password"
                    method="POST"
                    id="changePasswordForm"
                    novalidate
                >


                    <div class="account-settings-security">


                        <!-- CURRENT PASSWORD -->

                        <div class="account-settings-security-item">

                            <label for="currentPassword">
                                CURRENT PASSWORD
                            </label>


                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="currentPassword"
                                    name="currentPassword"
                                    autocomplete="current-password"
                                    required
                                >


                                <button
                                    type="button"
                                    class="password-toggle"
                                    data-target="currentPassword"
                                    aria-label="Show current password"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>

                            </div>

                        </div>



                        <!-- NEW PASSWORD -->

                        <div class="account-settings-security-item">

                            <label for="newPassword">
                                NEW PASSWORD
                            </label>


                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="newPassword"
                                    name="newPassword"
                                    autocomplete="new-password"
                                    minlength="8"
                                    required
                                >


                                <button
                                    type="button"
                                    class="password-toggle"
                                    data-target="newPassword"
                                    aria-label="Show new password"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>

                            </div>


                            <small>
                                Minimum 8 characters with letters, numbers and a special character.
                            </small>

                        </div>



                        <!-- CONFIRM PASSWORD -->

                        <div class="account-settings-security-item">

                            <label for="confirmPassword">
                                CONFIRM NEW PASSWORD
                            </label>


                            <div class="password-input-wrapper">

                                <input
                                    type="password"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    autocomplete="new-password"
                                    minlength="8"
                                    required
                                >


                                <button
                                    type="button"
                                    class="password-toggle"
                                    data-target="confirmPassword"
                                    aria-label="Show confirm password"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <div class="account-settings-section-actions">

                        <a
                            href="/profile/edit"
                            class="account-settings-cancel"
                        >
                            CANCEL
                        </a>


                        <button
                            type="submit"
                            class="account-settings-save"
                        >
                            UPDATE PASSWORD
                        </button>

                    </div>

                </form>

            </div>



            <!-- BACK TO PROFILE -->

            <div class="account-settings-bottom">

                <a
                    href="/profile"
                    class="account-settings-back"
                >
                    ← BACK TO PROFILE
                </a>

            </div>


        </section>

    </div>

</main>



<!-- =====================================================
     CHANGE PASSWORD JAVASCRIPT
====================================================== -->

<script>

    // =====================================================
    // PASSWORD VISIBILITY
    // =====================================================

    const passwordToggleButtons =
        document.querySelectorAll(".password-toggle");


    passwordToggleButtons.forEach(function (button) {

        button.addEventListener("click", function () {

            const targetId =
                button.getAttribute("data-target");

            const passwordInput =
                document.getElementById(targetId);

            const icon =
                button.querySelector("i");


            if (passwordInput.type === "password") {

                passwordInput.type = "text";

                icon.classList.remove("bi-eye");

                icon.classList.add("bi-eye-slash");

                button.setAttribute(
                    "aria-label",
                    "Hide password"
                );

            } else {

                passwordInput.type = "password";

                icon.classList.remove("bi-eye-slash");

                icon.classList.add("bi-eye");

                button.setAttribute(
                    "aria-label",
                    "Show password"
                );

            }

        });

    });



    // =====================================================
    // FRONTEND VALIDATION
    // =====================================================

    const changePasswordForm =
        document.getElementById("changePasswordForm");


    changePasswordForm.addEventListener(
        "submit",
        function (event) {

            const currentPassword =
                document.getElementById("currentPassword").value;

            const newPassword =
                document.getElementById("newPassword").value;

            const confirmPassword =
                document.getElementById("confirmPassword").value;


            // =================================================
            // CURRENT PASSWORD
            // =================================================

            if (!currentPassword) {

                event.preventDefault();

                alert(
                    "Please enter your current password."
                );

                return;

            }


            // =================================================
            // NEW PASSWORD
            // =================================================

            if (!newPassword) {

                event.preventDefault();

                alert(
                    "Please enter a new password."
                );

                return;

            }


            // =================================================
            // PASSWORD COMPLEXITY
            // =================================================

            const passwordRegex =
                /^(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,}$/;


            if (!passwordRegex.test(newPassword)) {

                event.preventDefault();

                alert(
                    "Password must contain at least 8 characters, including letters, numbers, and a special character."
                );

                return;

            }


            // =================================================
            // CONFIRM PASSWORD
            // =================================================

            if (!confirmPassword) {

                event.preventDefault();

                alert(
                    "Please confirm your new password."
                );

                return;

            }


            // =================================================
            // PASSWORD MATCH
            // =================================================

            if (newPassword !== confirmPassword) {

                event.preventDefault();

                alert(
                    "Passwords do not match."
                );

                return;

            }

        }
    );

</script>


<%- include("../partials/footer2") %>