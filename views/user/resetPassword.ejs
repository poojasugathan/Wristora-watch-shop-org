<%- include("../partials/header") %>

<main class="reset-password-page">

    <section class="reset-password-container">

        <h1 class="reset-password-title">
            Enter new Password
        </h1>


        <% if (error) { %>

            <div class="reset-password-error">
                <%= error %>
            </div>

        <% } %>


        <form
            action="/auth/reset-password"
            method="POST"
            class="reset-password-form"
        >

            <input
                type="password"
                name="password"
                placeholder="Enter new password"
                required
            >


            <p class="password-hint">
                Password must contain at least 8 characters,
                including alphabets, numbers, and special
                characters.
            </p>


            <input
                type="password"
                name="confirmPassword"
                placeholder="Confirm new password"
                required
            >


            <button type="submit">
                UPDATE PASSWORD
            </button>

        </form>

    </section>

</main>

<footer class="border-t border-gray-200 bg-[#F8F5EF]">

    <div class="h-[80px] flex items-center justify-center">

        <p class="uppercase tracking-[4px] text-[12px] text-gray-700">

            © 2024 Wristora Maison De Haute Horlogerie

        </p>

    </div>

</footer>

</body>
</html>
