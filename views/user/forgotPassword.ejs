<%- include("../partials/header") %>
<link rel="stylesheet" href="/css/forgotPassword.css">

<main class="forgot-password-page">

    <section class="forgot-password-container">

        <h1 class="forgot-password-title">
            Forgot Password ?
        </h1>


        <% if (error) { %>

            <div class="forgot-password-error">
                <%= error %>
            </div>

        <% } %>


        <form
            action="/auth/forgot-password"
            method="POST"
            class="forgot-password-form"
        >

            <label for="email">
                Enter your registered email
            </label>


            <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter your email"
                value="<%= formData.email %>"
                required
            >


            <button type="submit">
                SEND OTP
            </button>

        </form>

    </section>

</main>


<footer class="wristora-footer">

    <div class="wristora-footer-inner">

        <p class="wristora-footer-text">
            © 2024 Wristora Maison De Haute Horlogerie
        </p>

    </div>

</footer>

</body>
</html>