<%- include("../partials/header", { title: title, user: user }) %>

<link rel="stylesheet" href="/css/products.css">
<link rel="stylesheet" href="/css/cart.css">
<link rel="stylesheet" href="/css/checkout.css">

<%
    // Show whole rupees without decimals, otherwise 2 decimals.
    const money = (n) => Number(n).toLocaleString("en-IN", {
        minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
        maximumFractionDigits: 2
    });
%>

<main class="cart-page">

    <div class="cart-container">

        <p class="products-breadcrumb">
            <a href="/">HOME</a> &gt;
            <a href="/cart">CART</a> &gt; CHECKOUT
        </p>

        <div class="cart-page-header">
            <h1 class="products-title">Checkout</h1>
        </div>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="products-error"><%= error %></div>
        <% } %>

        <% if (typeof notice !== "undefined" && notice) { %>
            <div class="checkout-notice"><%= notice %></div>
        <% } %>

        <div id="checkout-client-error" class="products-error" style="display:none;"></div>


        <!-- One form wraps both columns so the Place Order button
             (in the summary) submits the chosen address + payment. -->
        <form
            id="checkout-form"
            action="/checkout/place-order"
            method="POST"
        >

            <div class="checkout-layout">

                <!-- =============================================
                     LEFT COLUMN
                ============================================== -->

                <div class="checkout-main">

                    <!-- SECTION 1 — DELIVERY ADDRESS -->

                    <section class="checkout-section">

                        <div class="checkout-section-header">
                            <h2>Delivery Address</h2>
                            <a href="/checkout/address/new" class="checkout-section-link">+ Add New Address</a>
                        </div>

                        <% if (addresses && addresses.length > 0) { %>

                            <div class="checkout-address-list">

                                <% addresses.forEach((address, index) => { %>

                                    <label class="checkout-address-card">

                                        <input
                                            type="radio"
                                            name="selectedAddress"
                                            value="<%= address._id %>"
                                            <%= (address.isDefault || (index === 0 && !addresses.some(a => a.isDefault))) ? "checked" : "" %>
                                        >

                                        <div class="checkout-address-details">

                                            <div class="checkout-address-name-row">
                                                <span class="checkout-address-name">
                                                    <%= address.addressName || "Address" %>
                                                </span>

                                                <% if (address.isDefault) { %>
                                                    <span class="checkout-address-default-tag">Default</span>
                                                <% } %>
                                            </div>

                                            <p class="checkout-address-person">
                                                <%= address.firstName %> <%= address.lastName %>
                                            </p>

                                            <p class="checkout-address-line">
                                                <%= address.addressLine1 %><% if (address.addressLine2) { %>, <%= address.addressLine2 %><% } %>
                                            </p>

                                            <p class="checkout-address-line">
                                                <%= address.city %>, <%= address.state %> - <%= address.pinCode %>, <%= address.country %>
                                            </p>

                                            <p class="checkout-address-phone">
                                                <%= address.phone %>
                                            </p>

                                        </div>

                                        <a
                                            href="/checkout/address/<%= address._id %>/edit"
                                            class="checkout-address-edit"
                                        >
                                            Edit
                                        </a>

                                    </label>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <div class="checkout-empty-address">
                                <p>You haven't added a delivery address yet.</p>
                                <a href="/checkout/address/new" class="products-empty-btn">Add Address</a>
                            </div>

                        <% } %>

                    </section>


                    <!-- SECTION 2 — PAYMENT METHOD -->

                    <section class="checkout-section">

                        <div class="checkout-section-header">
                            <h2>Payment Method</h2>
                        </div>

                        <label class="checkout-address-card">

                            <input
                                type="radio"
                                name="paymentMethod"
                                value="COD"
                                checked
                            >

                            <div class="checkout-address-details">
                                <span class="checkout-address-name"><%= paymentLabel %></span>
                                <p class="checkout-address-line">
                                    Pay in cash when your order is delivered.
                                </p>
                            </div>

                        </label>

                    </section>


                    <!-- SECTION 3 — ORDER ITEMS
                         Every value here was recalculated from the
                         database by the server just before rendering. -->

                    <section class="checkout-section">

                        <div class="checkout-section-header">
                            <h2>Order Items</h2>
                            <a href="/cart" class="checkout-section-link">Edit Cart</a>
                        </div>

                        <div class="checkout-item-list">

                            <% lines.forEach((line) => { %>

                                <div class="checkout-item">

                                    <div class="checkout-item-image">
                                        <% if (line.productImage) { %>
                                            <img src="<%= line.productImage %>" alt="<%= line.productName %>">
                                        <% } else { %>
                                            <div class="image-missing"></div>
                                        <% } %>
                                    </div>

                                    <div class="checkout-item-info">

                                        <p class="checkout-item-name"><%= line.productName %></p>

                                        <% if (line.brand) { %>
                                            <p class="checkout-item-brand"><%= line.brand %></p>
                                        <% } %>

                                        <p class="checkout-item-qty">
                                            &#8377;<%= money(line.unitPrice) %> &times; <%= line.quantity %>
                                        </p>

                                    </div>

                                    <div class="checkout-item-subtotal">
                                        &#8377;<%= money(line.itemTotal) %>
                                    </div>

                                </div>

                            <% }) %>

                        </div>

                    </section>

                </div>


                <!-- =============================================
                     RIGHT COLUMN — ORDER SUMMARY
                ============================================== -->

                <aside class="checkout-summary">

                    <h2>Order Summary</h2>

                    <div class="checkout-summary-row">
                        <span>Subtotal (<%= lines.length %> <%= lines.length === 1 ? "item" : "items" %>)</span>
                        <span>&#8377;<%= money(pricing.subtotal) %></span>
                    </div>

                    <% if (pricing.discountTotal > 0) { %>
                        <div class="checkout-summary-row">
                            <span>Discount</span>
                            <span class="checkout-summary-free">- &#8377;<%= money(pricing.discountTotal) %></span>
                        </div>
                    <% } %>

                    <% if (pricing.tax > 0) { %>
                        <div class="checkout-summary-row">
                            <span>Tax</span>
                            <span>&#8377;<%= money(pricing.tax) %></span>
                        </div>
                    <% } %>

                    <div class="checkout-summary-row">
                        <span>Shipping</span>
                        <% if (pricing.shipping > 0) { %>
                            <span>&#8377;<%= money(pricing.shipping) %></span>
                        <% } else { %>
                            <span class="checkout-summary-free">Free</span>
                        <% } %>
                    </div>

                    <div class="cart-summary-divider"></div>

                    <div class="checkout-summary-row checkout-summary-total">
                        <span>Total</span>
                        <span>&#8377;<%= money(pricing.finalTotal) %></span>
                    </div>

                    <p class="checkout-summary-payment">
                        Payment: <strong><%= paymentLabel %></strong>
                    </p>

                    <button
                        type="submit"
                        id="place-order-btn"
                        class="cart-continue-btn"
                        <%= (addresses && addresses.length > 0) ? "" : "disabled" %>
                    >
                        Place Order
                    </button>

                    <a href="/cart" class="checkout-back-link">
                        &larr; Back to Cart
                    </a>

                </aside>

            </div>

        </form>

    </div>

</main>

<script src="/js/checkout.js"></script>

<%- include("../partials/footer2") %>