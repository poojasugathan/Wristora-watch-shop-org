<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - Wristora</title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600&family=Montserrat:wght@400;500;600&display=swap"
        rel="stylesheet"
    >
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Montserrat", sans-serif;
            background-image:
                linear-gradient(
                    rgba(0, 0, 0, 0.42),
                    rgba(0, 0, 0, 0.42)
                ),
                url("/images/login.png");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =================================================
           LOGIN CARD
        ================================================= */

        .login-card {
            width: 480px;
            min-height: 725px;
            background: #ffffff;
            border-radius: 22px;
            padding: 48px 32px 40px;
            position: relative;
        }


        /* =================================================
           TOP SECTION
        ================================================= */

        .login-title {
            font-family: "EB Garamond", serif;
            font-size: 36px;
            font-weight: 600;
            color: #101828;
            margin: 0;
            line-height: 1;
        }


        .create-account {
            color: #181818;
            font-size: 14px;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .create-account:hover {
            color: #000000;
        }


        .close-btn {
            position: absolute;
            top: 32px;
            right: 32px;
            border: none;
            background: transparent;
            padding: 0;
            font-size: 25px;
            line-height: 1;
            color: #111111;
            cursor: pointer;
        }


        /* =================================================
           FORM
        ================================================= */

        .form-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            color: #202020;
            margin-bottom: 9px;
        }


        .login-input {
            height: 56px;
            border: 1px solid #222222;
            border-radius: 12px;
            padding: 0 16px;
            font-size: 16px;
            color: #222222;
            box-shadow: none !important;
        }


        .login-input::placeholder {
            color: #7b8495;
            opacity: 1;
        }


        .login-input:focus {
            border-color: #222222;
        }


        .password-wrapper {
            position: relative;
        }


        .password-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #555555;
            cursor: pointer;
            padding: 0;
        }


        /* =================================================
           FORGOT PASSWORD
        ================================================= */

        .forgot-password {
            display: inline-block;
            margin-top: 22px;
            color: #18202c;
            font-size: 12px;
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 3px;
        }


        /* =================================================
           LOGIN BUTTON
        ================================================= */

        .login-btn {
            width: 100%;
            height: 60px;
            margin-top: 26px;
            border: none;
            border-radius: 32px;
            background: #f3cfca;
            color: #18202c;
            font-size: 18px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }


        .login-btn:hover {
            background: #edc3bd;
        }


        /* =================================================
           GOOGLE BUTTON
        ================================================= */

        .google-btn {
            width: 240px;
            height: 58px;
            margin: 70px auto 0;
            border: 1px solid #d5d5d5;
            border-radius: 4px;
            background: #ffffff;
            color: #282828;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            font-size: 16px;
            letter-spacing: 0.5px;
        }


        .google-icon {
            width: 19px;
            height: 19px;
        }


        /* =================================================
           ERROR MESSAGE
        ================================================= */

        .login-error {
            margin-top: 15px;
            margin-bottom: 0;
            padding: 11px 13px;
            border-radius: 7px;
            background: #fce8e6;
            color: #b42318;
            font-size: 13px;
        }


        /* =================================================
           MOBILE
        ================================================= */

        @media (max-width: 576px) {

            body {
                padding: 20px;
            }

            .login-card {
                width: 100%;
                min-height: auto;
                padding: 38px 24px 35px;
                border-radius: 18px;
            }

            .login-title {
                font-size: 32px;
            }

            .close-btn {
                top: 25px;
                right: 24px;
            }

            .google-btn {
                margin-top: 55px;
            }
        }

    </style>

</head>


<body>


    <!-- =================================================
         LOGIN CARD
    ================================================= -->

    <div class="login-card">


        <!-- Close Button -->

        <a
            href="/"
            class="close-btn"
            aria-label="Close"
        >
            <i class="bi bi-x"></i>
        </a>


        <!-- =================================================
             HEADER
        ================================================= -->

        <div
            class="d-flex justify-content-between align-items-start"
            style="padding-right: 8px;"
        >

            <h1 class="login-title">
                Login
            </h1>


            <a
                href="/auth/signup"
                class="create-account"
            >
                create an account
            </a>

        </div>


        <!-- =================================================
             ERROR MESSAGE
        ================================================= -->

       <% if (typeof error !== "undefined" && error) { %>
    <div class="login-error">
        <%= error %>
    </div>

<% } %>


<% if (typeof success !== "undefined" && success) { %>

    <script>

        Swal.fire({
            icon: "success",
            title: "Password Updated",
            text: "<%= success %>",
            confirmButtonColor: "#292929"
        });

    </script>

<% } %>


        <!-- =================================================
             LOGIN FORM
        ================================================= -->

        <form
            action="/auth/login"
            method="POST"
            id="loginForm"
            novalidate
        >


            <!-- EMAIL -->

            <div class="mt-4">

                <label
                    for="email"
                    class="form-label"
                >
                    EMAIL
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-control login-input"
                    placeholder="Email"
                    value="<%= formData.email %>"
                    autocomplete="email"
                >

                <div
                    id="emailError"
                    class="text-danger mt-2"
                    style="font-size: 12px;"
                ></div>

            </div>


            <!-- PASSWORD -->

            <div class="mt-4">

                <label
                    for="password"
                    class="form-label"
                >
                    PASSWORD
                </label>

                <div class="password-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control login-input"
                        placeholder="Password"
                        autocomplete="current-password"
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        id="togglePassword"
                        aria-label="Show password"
                    >
                        <i class="bi bi-eye"></i>
                    </button>

                </div>

                <div
                    id="passwordError"
                    class="text-danger mt-2"
                    style="font-size: 12px;"
                ></div>

            </div>


            <!-- FORGOT PASSWORD -->

            <a
                href="/auth/forgot-password"
                class="forgot-password"
            >
                Forgot Password?
            </a>


            <!-- LOGIN BUTTON -->

            <button
                type="submit"
                class="login-btn"
            >
                LOGIN
            </button>


        </form>


        <!-- =================================================
             GOOGLE LOGIN
        ================================================= -->

        <a
    href="/auth/google"
    class="google-btn text-decoration-none"
>
    <span
        style="
            font-size: 19px;
            font-weight: 600;
            color: #4285f4;
        "
    >
        G
    </span>

    <span>
        GOOGLE
    </span>
</a>


    </div>


    <!-- =================================================
         JAVASCRIPT
    ================================================= -->

    <script>

        const loginForm =
            document.getElementById("loginForm");

        const emailInput =
            document.getElementById("email");

        const passwordInput =
            document.getElementById("password");

        const emailError =
            document.getElementById("emailError");

        const passwordError =
            document.getElementById("passwordError");


        // =================================================
        // PASSWORD SHOW / HIDE
        // =================================================

        const togglePassword =
            document.getElementById("togglePassword");

        togglePassword.addEventListener(
            "click",
            function () {

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    togglePassword.innerHTML =
                        '<i class="bi bi-eye-slash"></i>';

                    togglePassword.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                } else {

                    passwordInput.type = "password";

                    togglePassword.innerHTML =
                        '<i class="bi bi-eye"></i>';

                    togglePassword.setAttribute(
                        "aria-label",
                        "Show password"
                    );
                }

            }
        );


        // =================================================
        // FRONTEND VALIDATION
        // =================================================

        loginForm.addEventListener(
            "submit",
            function (event) {

                let isValid = true;

                emailError.textContent = "";
                passwordError.textContent = "";


                const email =
                    emailInput.value.trim();

                const password =
                    passwordInput.value;


                if (!email) {

                    emailError.textContent =
                        "Please enter your email.";

                    isValid = false;

                } else if (
                    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
                ) {

                    emailError.textContent =
                        "Please enter a valid email address.";

                    isValid = false;
                }


                if (!password) {

                    passwordError.textContent =
                        "Please enter your password.";

                    isValid = false;
                }


                if (!isValid) {
                    event.preventDefault();
                }

            }
        );

        
        

    </script>


</body>

</html>