            <input
                type="text"
                maxlength="1"
                class="otp-input"
                inputmode="numeric"
            >

            <input
                type="text"
                maxlength="1"
                class="otp-input"
                inputmode="numeric"
            >

            <input
                type="text"
                maxlength="1"
                class="otp-input"
                inputmode="numeric"
            >

            <input
                type="text"
                maxlength="1"
                class="otp-input"
                inputmode="numeric"
            >
            <input
                type="text"
                maxlength="1"
                class="otp-input"
                inputmode="numeric"
            >

            <input
                type="hidden"
                name="otp"
                id="otpValue"
            >

        </div>


        <!-- TIMER -->

