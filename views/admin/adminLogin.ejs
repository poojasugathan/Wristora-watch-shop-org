<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Wristora</title>

    <link
        rel="stylesheet"
        href="/css/adminLogin.css"
    >

</head>


<body>


    <!-- =====================================================
         ADMIN HEADER
    ====================================================== -->

    <header class="admin-header">

        <div class="admin-logo">
            WRISTORA
        </div>

    </header>



    <!-- =====================================================
         ADMIN LOGIN PAGE
    ====================================================== -->

    <main class="admin-login-page">


        <section class="admin-login-container">


            <!-- =================================================
                 TITLE
            ================================================== -->

            <h1 class="admin-login-title">
                ADMIN LOGIN
            </h1>



            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (error) { %>

                <div class="admin-login-error">
                    <%= error %>
                </div>

            <% } %>



            <!-- =================================================
                 LOGIN FORM
            ================================================== -->

            <form
                action="/admin/login"
                method="POST"
                class="admin-login-form"
            >


                <!-- =============================================
                     EMAIL
                ============================================== -->

                <div class="admin-form-group">

                    <label for="email">
                        EMAIL
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= formData.email %>"
                        autocomplete="email"
                    >

                </div>



                <!-- =============================================
                     PASSWORD
                ============================================== -->

                <div class="admin-form-group">

                    <label for="password">
                        PASSWORD
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="current-password"
                    >

                </div>



                <!-- =============================================
                     LOGIN BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="admin-login-button"
                >
                    LOG IN
                </button>


            </form>




        </section>


    </main>


</body>

</html>