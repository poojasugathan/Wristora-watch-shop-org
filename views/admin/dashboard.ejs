<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Wristora</title>

    <link rel="stylesheet" href="/css/adminDashboard.css">

    <link rel="stylesheet" href="/css/adminAnalytics.css">

</head>

<%
    // PHASE 58: every number below is calculated by the server from
    // real orders (services/dashboardService.js). The sales rule is the
    // same one the Sales Report uses.

    const inr = (n) =>
        "₹" + Number(n || 0).toLocaleString("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

    // "+12.4%" / "-3.1%" / "New" (when the previous period had nothing)
    const growthText = (value) => {
        if (value === null) return "New";
        return (value > 0 ? "+" : "") + value + "%";
    };

    const growthClass = (value) =>
        value !== null && value < 0 ? "negative" : "positive";
%>

<body>

    <div class="admin-layout">

        <%- include("partials/sidebar", { currentPage: "dashboard" }) %>


        <main class="admin-main">

            <div class="dashboard-header">

                <div>

                    <h1>Dashboard</h1>

                    <h2>
                        <% if (range) { %>
                            Sales report for <%= range.label %>
                        <% } else { %>
                            Choose a period
                        <% } %>
                    </h2>

                </div>

                <!-- FILTER: the server does the work -->
                <form
                    class="an-filter"
                    action="/admin/dashboard"
                    method="GET"
                    id="an-filter"
                >

                    <div class="period-toggle">

                        <% periods.forEach((item) => { %>

                            <label class="period-button an-period <%= period === item.value ? 'active' : '' %>">

                                <input
                                    type="radio"
                                    name="period"
                                    value="<%= item.value %>"
                                    <%= period === item.value ? "checked" : "" %>
                                >

                                <%= item.label %>

                            </label>

                        <% }) %>

                    </div>

                    <div class="an-dates" id="an-dates" <%= period === "custom" ? "" : "hidden" %>>

                        <label>
                            From
                            <input type="date" name="from" value="<%= from %>">
                        </label>

                        <label>
                            To
                            <input type="date" name="to" value="<%= to %>">
                        </label>

                    </div>

                    <button type="submit" class="an-apply">Apply</button>

                </form>

            </div>


            <% if (error) { %>
                <div class="an-error"><%= error %></div>
            <% } %>


            <!-- =====================================================
                 SUMMARY CARDS
            ====================================================== -->

            <section class="summary-grid">

                <div class="summary-card">

                    <div class="summary-label">Net Sales</div>

                    <div class="summary-subtitle">
                        After discounts and coupons
                    </div>

                    <div class="summary-value"><%= inr(data.summary.netSales) %></div>

                    <span class="growth-badge <%= growthClass(data.salesGrowth) %>">
                        Sales <%= growthText(data.salesGrowth) %>
                    </span>

                    <div class="previous-value">
                        Previous period (<%= inr(data.previous.netSales) %>)
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">Total Orders</div>

                    <div class="summary-subtitle">
                        Cancelled orders not counted
                    </div>

                    <div class="summary-value"><%= data.summary.totalOrders %></div>

                    <span class="growth-badge <%= growthClass(data.orderGrowth) %>">
                        Orders <%= growthText(data.orderGrowth) %>
                    </span>

                    <div class="previous-value">
                        Previous period (<%= data.previous.totalOrders %>)
                    </div>

                </div>


                <div class="summary-card pending-card">

                    <div class="summary-label">Pending &amp; Cancelled</div>

                    <div class="summary-subtitle">
                        Orders placed in this period
                    </div>

                    <div class="pending-grid">

                        <div>
                            <span class="small-label">Pending</span>
                            <strong><%= data.pendingOrders %></strong>
                        </div>

                        <div>
                            <span class="small-label">Cancelled</span>
                            <strong class="cancelled-number"><%= data.cancelledOrders %></strong>
                        </div>

                    </div>

                </div>

            </section>


            <!-- =====================================================
                 SALES CHART (Chart.js)
            ====================================================== -->

            <section class="sales-chart-card">

                <div class="chart-statistics">

                    <div>
                        <strong><%= inr(data.summary.grossSales) %></strong>
                        <span>Gross Sales</span>
                    </div>

                    <div>
                        <strong><%= inr(data.summary.totalDiscount) %></strong>
                        <span>Total Discount</span>
                    </div>

                    <div>
                        <strong><%= data.summary.itemsSold %></strong>
                        <span>Items Sold</span>
                    </div>

                </div>

                <div class="an-chart-wrap">

                    <canvas id="sales-chart" aria-label="Sales chart" role="img"></canvas>

                    <p class="an-chart-note" id="an-chart-note" hidden></p>

                </div>

                <script type="application/json" id="chart-data"><%- chartJson %></script>

            </section>


            <!-- =====================================================
                 BEST SELLING (top 10)
            ====================================================== -->

            <section class="dashboard-bottom-grid">

                <div class="best-selling-card">

                    <h2>Top 10 Best-Selling Products</h2>

                    <div class="product-table-header">
                        <span>PRODUCT</span>
                        <span>QTY SOLD</span>
                        <span>STATUS</span>
                        <span>SALES</span>
                    </div>

                    <% if (data.topProducts.length === 0) { %>

                        <p class="an-empty">No sales in this period.</p>

                    <% } %>

                    <% data.topProducts.forEach((product) => { %>

                        <div class="product-row">

                            <div class="product-name">

                                <div class="product-image">
                                    <% if (product.image) { %>
                                        <img src="<%= product.image %>" alt="">
                                    <% } else { %>
                                        W
                                    <% } %>
                                </div>

                                <span><%= product.name %></span>

                            </div>

                            <span><%= product.quantity %></span>

                            <span class="<%= product.status === 'In stock' ? 'stock-status' : 'stock-status out' %>">
                                <span class="status-dot"></span>
                                <%= product.status %>
                            </span>

                            <strong><%= inr(product.sales) %></strong>

                        </div>

                    <% }) %>

                    <p class="an-footnote">
                        Sales = price after the product offer, before any coupon.
                    </p>

                </div>


                <div class="an-side">

                    <div class="an-rank-card">

                        <h2>Top 10 Categories</h2>

                        <% if (data.topCategories.length === 0) { %>
                            <p class="an-empty">No sales in this period.</p>
                        <% } %>

                        <ol class="an-rank-list">
                            <% data.topCategories.forEach((item) => { %>
                                <li>
                                    <span class="an-rank-name"><%= item.name %></span>
                                    <span class="an-rank-qty"><%= item.quantity %> sold</span>
                                    <strong><%= inr(item.sales) %></strong>
                                </li>
                            <% }) %>
                        </ol>

                    </div>


                    <div class="an-rank-card">

                        <h2>Top 10 Brands</h2>

                        <% if (data.topBrands.length === 0) { %>
                            <p class="an-empty">No sales in this period.</p>
                        <% } %>

                        <ol class="an-rank-list">
                            <% data.topBrands.forEach((item) => { %>
                                <li>
                                    <span class="an-rank-name"><%= item.name %></span>
                                    <span class="an-rank-qty"><%= item.quantity %> sold</span>
                                    <strong><%= inr(item.sales) %></strong>
                                </li>
                            <% }) %>
                        </ol>

                    </div>

                </div>

            </section>

        </main>

    </div>


    <script src="/vendor/chartjs/chart.umd.js"></script>
    <script src="/js/adminDashboard.js"></script>

</body>

</html>
