<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Wristora</title>

    <link
        rel="stylesheet"
        href="/css/adminDashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/adminCategories.css"
    >

</head>


<body>

<div class="admin-layout">


    <%- include("partials/sidebar", { currentPage: "categories" }) %>


    <main class="admin-main category-main">


        <!-- =================================================
             PAGE HEADER
        ================================================== -->

        <div class="category-header">

            <div>

                <h1>
                    Categories
                </h1>

                <h2>
                    Manage your product categories
                </h2>

            </div>


            <a
                href="/admin/categories/add"
                class="category-add-button"
            >
                + Add Category
            </a>

        </div>



        <!-- =================================================
             SUCCESS / ERROR MESSAGE
        ================================================== -->

        <% if (typeof error !== "undefined" && error) { %>

            <div class="category-error">
                <%= error %>
            </div>

        <% } %>



        <!-- =================================================
             LIST HEADER: SEARCH
        ================================================== -->

        <div class="category-list-header">

            <h2>
                Category List
            </h2>


            <div class="category-tools">

                <form
                    class="category-search"
                    action="/admin/categories"
                    method="GET"
                >

                    <span class="search-icon">
                        ⌕
                    </span>

                    <input
                        type="text"
                        name="search"
                        placeholder="Search category"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                        autocomplete="off"
                    >

                </form>


                <% if (typeof search !== "undefined" && search) { %>

                    <a
                        href="/admin/categories"
                        class="category-tool-button"
                        title="Clear search"
                    >
                        X
                    </a>

                <% } %>

            </div>

        </div>



        <!-- =================================================
             CATEGORY TABLE
        ================================================== -->

        <section class="category-table-card">

            <% if (categories && categories.length > 0) { %>


                <div class="category-table">


                    <div class="category-table-header">

                        <span>NAME</span>

                        <span>DESCRIPTION</span>

                        <span>STATUS</span>

                        <span>CREATED</span>

                        <span>ACTION</span>

                    </div>


                    <% categories.forEach(category => { %>

                        <div class="category-row">


                            <strong>
                                <%= category.name %>
                            </strong>


                            <span class="category-description">
                                <%= category.description || "—" %>
                            </span>


                            <% if (category.isListed === true) { %>

                                <span class="category-status active">
                                    <span class="status-dot"></span>
                                    Listed
                                </span>

                            <% } else { %>

                                <span class="category-status blocked">
                                    <span class="status-dot"></span>
                                    Unlisted
                                </span>

                            <% } %>


                            <span>

                                <%= category.createdAt
                                    ? new Date(category.createdAt).toLocaleDateString("en-IN", {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    })
                                    : "—"
                                %>

                            </span>


                            <div class="category-action">

                                <a
                                    href="/admin/categories/edit/<%= category._id %>"
                                    class="category-action-button edit"
                                >
                                    EDIT
                                </a>


                                <form
                                    action="/admin/categories/delete/<%= category._id %>"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this category?');"
                                >

                                    <button
                                        type="submit"
                                        class="category-action-button delete"
                                    >
                                        DELETE
                                    </button>

                                </form>

                            </div>


                        </div>

                    <% }) %>


                </div>


            <% } else { %>


                <div class="category-empty">

                    <h3>
                        No categories found
                    </h3>

                    <p>
                        Start by adding your first category.
                    </p>

                </div>


            <% } %>

        </section>



        <!-- =================================================
             PAGINATION
        ================================================== -->

        <% if (totalPages > 1) { %>

            <div class="category-pagination">

                <% if (currentPage > 1) { %>

                    <a
                        href="/admin/categories?page=<%= currentPage - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                        class="pagination-button"
                    >
                        Previous
                    </a>

                <% } else { %>

                    <span class="pagination-button disabled">
                        Previous
                    </span>

                <% } %>


                <div class="pagination-pages">

                    <% for (
                        let pageNumber = 1;
                        pageNumber <= totalPages;
                        pageNumber++
                    ) { %>

                        <% if (pageNumber === currentPage) { %>

                            <span class="pagination-page active">
                                <%= pageNumber %>
                            </span>

                        <% } else { %>

                            <a
                                href="/admin/categories?page=<%= pageNumber %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                                class="pagination-page"
                            >
                                <%= pageNumber %>
                            </a>

                        <% } %>

                    <% } %>

                </div>


                <% if (currentPage < totalPages) { %>
                    <a
                    
                        href="/admin/categories?page=<%= currentPage + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
                        class="pagination-button"
                    >
                        Next
                    </a>

                <% } else { %>

                    <span class="pagination-button disabled">
                        Next
                    </span>

                <% } %>

            </div>

        <% } %>


    </main>

</div>

</body>

</html>