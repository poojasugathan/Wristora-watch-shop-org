<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Wristora</title>

    <link
        rel="stylesheet"
        href="/css/adminDashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/adminProducts.css"
    >

</head>


<body>

<div class="admin-layout">


    <%- include("partials/sidebar", { currentPage: "addProduct" }) %>


    <main class="admin-main product-main">


        <div class="product-header">

            <div>

                <h1>
                    Add New Product
                </h1>

                <h2>
                    Fill in the details below
                </h2>

            </div>

        </div>


        <% if (typeof error !== "undefined" && error) { %>

            <div class="product-error">
                <%= error %>
            </div>

        <% } %>


        <form
            action="/admin/products/add"
            method="POST"
            enctype="multipart/form-data"
            class="product-form-card"
        >

            <div class="product-form-group">

                <label>Product Name</label>

                <input
                    type="text"
                    name="productName"
                    value="<%= formData.productName %>"
                    placeholder="e.g. Rolex Daytona Ref. 116500LN"
                >

            </div>


            <div class="product-form-group">

                <label>Description</label>

                <textarea
                    name="description"
                    rows="4"
                    placeholder="Describe the watch..."
                ><%= formData.description %></textarea>

            </div>


            <div class="product-form-row">

                <div class="product-form-group">

                    <label>Brand</label>

                    <input
                        type="text"
                        name="brand"
                        value="<%= formData.brand %>"
                        placeholder="e.g. Rolex"
                    >

                </div>


                <div class="product-form-group">

                    <label>Category</label>

                    <select name="category">

                        <option value="">
                            Select a category
                        </option>

                        <% categories.forEach(cat => { %>

                            <option
                                value="<%= cat._id %>"
                                <%= formData.category === String(cat._id) ? "selected" : "" %>
                            >
                                <%= cat.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>

            </div>


            <div class="product-form-row">

                <div class="product-form-group">

                    <label>Price (₹)</label>

                    <input
                        type="number"
                        name="price"
                        step="1000"
                        min="0"
                        value="<%= formData.price %>"
                        placeholder="e.g. 125000"
                    >

                </div>


                <div class="product-form-group">

                    <label>Discount (%)</label>

                    <input
                        type="number"
                        name="discount"
                        step="5"
                        min="0"
                        max="100"
                        value="<%= formData.discount %>"
                        placeholder="e.g. 10"
                    >

                </div>


                <div class="product-form-group">

                    <label>Stock</label>

                    <input
                        type="number"
                        name="stock"
                        min="0"
                        value="<%= formData.stock %>"
                        placeholder="e.g. 12"
                    >

                </div>

            </div>


            <div class="product-form-group">

                <label>Product Images (minimum 3)</label>

                <input
                    type="file"
                    name="images"
                    accept="image/jpeg,image/png,image/webp"
                    multiple
                >

                <p class="product-form-hint">
                    Select at least 3 images. Allowed formats: JPG, PNG, WEBP. Max 5MB each.
                </p>

            </div>


            <div class="product-form-group checkbox-group">

                <label>

                    <input
                        type="checkbox"
                        name="isListed"
                        <%= formData.isListed ? "checked" : "" %>
                    >

                    List this product for customers immediately

                </label>

            </div>


            <div class="product-form-actions">

                <a
                    href="/admin/products"
                    class="product-cancel-button"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="product-submit-button"
                >
                    Add Product
                </button>

            </div>

        </form>


    </main>

</div>

</body>

</html>